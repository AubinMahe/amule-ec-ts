{
   "printWidth": 132,
   "tabWidth": 3,
   "useTabs": false,
   "semi": true,
   "singleQuote": false,
   "trailingComma": "all",
   "bracketSpacing": true,
   "arrowParens": "always",
   "endOfLine": "lf",
   "plugins": ["prettier-plugin-compact-markdown-table"],
   "overrides": [
      {
         "files": "*.md",
         "options": {
            "proseWrap": "always",
            "tableLayout": "compact"
         }
      }
   ]
}
