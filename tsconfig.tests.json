{
   "extends"        : "./tsconfig.json",
   "compilerOptions": {
      "declaration"    : false,
      "declarationMap" : false,
      "noEmit"         : true,
      "rootDir"        : ".",
      "sourceMap"      : false,
      "tsBuildInfoFile": "./tsconfig.tests.tsbuildinfo",
      "types"          : ["node", "mocha"]
   },
   "include": [
      "./src/**/*.ts",
      "./tests/**/*.ts"
   ]
}
