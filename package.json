{
   "author"         : "Aubin MAHÉ <aubin.mahe@wanadoo.fr>",
   "bugs"           : "https://github.com/AubinMahe/amule-ec-ts/issues",
   "description"    : "TypeScript client library for aMule's binary External Connections (EC) protocol",
   "files"          : ["dist"],
   "homepage"       : "https://github.com/AubinMahe/amule-ec-ts#readme",
   "keywords"       : ["aMule", "amuled", "EC", "External Connections"],
   "license"        : "GPL-3.0-or-later",
   "main"           : "./dist/index.js",
   "name"           : "amule-ec",
   "type"           : "module",
   "types"          : "./dist/index.d.ts",
   "version"        : "2.28.0",
   "allowScripts"   : {
      "esbuild@0.28.1": true
   },
   "devDependencies": {
      "@eslint/js"                            : "^10.0.1",
      "@types/chai"                           : "^5.2.3",
      "@types/mocha"                          : "^10.0.10",
      "@types/node"                           : "^22.10.5",
      "chai"                                  : "^6.2.2",
      "eslint-plugin-comment-length"          : "^2.3.1",
      "eslint-plugin-jsdoc"                   : "^64.2.1",
      "eslint-plugin-sonarjs"                 : "^4.0.3",
      "globals"                               : "^17.7.0",
      "markdownlint-cli2"                     : "^0.23.2",
      "mocha"                                 : "^11.3.0",
      "monocart-coverage-reports"             : "^2.12.11",
      "prettier"                              : "^3.9.6",
      "prettier-plugin-compact-markdown-table": "^0.1.0",
      "tsx"                                   : "^4.22.3",
      "typescript"                            : "^5.7.2",
      "typescript-eslint"                     : "^8.59.4"
   },
   "engines"        : {
      "node": ">=18"
   },
   "exports"        : {
      ".": {
         "import": "./dist/index.js",
         "types" : "./dist/index.d.ts"
      }
   },
   "repository"     : {
      "type": "git",
      "url" : "git+https://github.com/AubinMahe/amule-ec-ts.git"
   },
   "scripts"        : {
      "build"           : "tsc --build tsconfig.src.json",
      "check"           : "rm -rf dist *.tsbuildinfo coverage && npm run lint && npm run build && npm run test",
      "choices-coverage": "node scripts/choices-coverage.mjs",
      "lint"            : "tsc --build tsconfig.json && eslint src tests --ext .ts",
      "lint:fix"        : "npm run lint:md-fix ; npm run lint:style-fix ; npm run lint:ts-fix ; npm run lint:pckg-fix",
      "lint:md-fix"     : "markdownlint-cli2 --fix ; prettier \"*.md\" --write",
      "lint:pckg-fix"   : "node scripts/format-package.mjs --in-place package.json",
      "lint:style"      : "eslint       src tests --ext .ts",
      "lint:style-fix"  : "eslint --fix src tests --ext .ts",
      "lint:ts-fix"     : "prettier \"src/**/*.ts\" \"tests/**/*.ts\" --write",
      "pack-release"    : "npm pack",
      "prepack"         : "npm run build",
      "prepare"         : "npm run build",
      "repl"            : "node --import tsx ./tests/repl/main.ts",
      "repl-run"        : "node scripts/repl-run.mjs",
      "test"            : "mocha",
      "test:coverage"   : "mcr mocha"
   }
}
